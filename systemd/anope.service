[Unit]
Description=Anope IRC Services
After=network.target unrealircd.service

[Service]
User=irchub
ExecStart=/home/irchub/services/bin/anoperc start
ExecStop=/home/irchub/services/bin/anoperc stop
ExecReload=/home/irchub/services/bin/anoperc reload
PIDFile=/home/irchub/services/data/services.pid
Type=forking
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
