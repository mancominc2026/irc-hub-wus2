[Unit]
Description=UnrealIRCd IRC Server
After=network.target

[Service]
User=irchub
ExecStart=/home/irchub/unrealircd/unrealircd start
ExecStop=/home/irchub/unrealircd/unrealircd stop
ExecReload=/home/irchub/unrealircd/unrealircd rehash
PIDFile=/home/irchub/unrealircd/data/unrealircd.pid
Type=forking
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
